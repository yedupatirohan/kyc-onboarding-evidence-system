# Copy this file to .env to override defaults. Never commit .env.
# Defaults are already fixed in code, so .env is optional.

KYC_SEED=20261022
KYC_AS_OF_DATE=2026-10-22

# Leave empty to use SQLite at data/output/kyc.db
KYC_DATABASE_URL=

# Expiry alert lead times (days before expiry), comma separated
KYC_ALERT_LEAD_DAYS=90,60,30

# Review frequency by risk level (months)
KYC_REVIEW_MONTHS_HIGH=6
KYC_REVIEW_MONTHS_MEDIUM=12
KYC_REVIEW_MONTHS_LOW=24

# Baseline dataset volumes
KYC_N_CUSTOMERS=8000
KYC_N_BUSINESS=1000
KYC_N_DOCUMENTS=20000
KYC_N_REVIEWS=3000
